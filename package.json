{
  "name": "clio-muse-tours",
  "version": "1.0.0",
  "description": "A simple Express server for Clio Muse Tours",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest --forceExit --detectOpenHandles"
  },
  "license": "ISC",
  "jest": {
    "testMatch": ["**/tests/**/*.test.js"],
    "roots": ["<rootDir>/tests", "<rootDir>/src"],
    "moduleDirectories": ["node_modules", "src"]
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "pg": "^8.21.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
